# ---------------------------------------------------------------------------
# Database — Prisma Postgres
# ---------------------------------------------------------------------------

# Prisma Console (https://console.prisma.io) -> your project -> your database
# -> Connect / API keys. Copy the `prisma+postgres://` string.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------

# Encrypts the JWE session cookie. Generate one with either:
#   openssl rand -base64 33
#   pnpm dlx auth secret
AUTH_SECRET="REPLACE_ME"

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------

# Keycloak admin console -> your realm -> Clients -> your client -> "Client ID".
AUTH_KEYCLOAK_ID="robotics-inventory"

# Same client -> Credentials tab -> "Client Secret".
# That tab only exists when "Client authentication" is ON (confidential client).
AUTH_KEYCLOAK_SECRET="REPLACE_ME"

# Find it under Realm settings -> General -> Endpoints -> "OpenID Endpoint
# Configuration", then copy the `issuer` field from that JSON verbatim.
AUTH_KEYCLOAK_ISSUER="https://keycloak.example.com/realms/robotics"

# Required whenever you reach the app on anything other than "localhost".
# It must include the port, and must match a registered Keycloak redirect URI.
AUTH_URL="http://localhost:3000"
