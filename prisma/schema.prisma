generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  email  String  @id
  name   String
  idHeld Boolean @default(false)

  teams Team[]
  items Item[]
}

model Team {
  id           String  @id @default(uuid(7))
  name         String?
  contact      Contact @relation(fields: [contactEmail], references: [email])
  contactEmail String

  loans Loan[]
}

model Item {
  id            String   @id @default(uuid(7))
  name          String
  imageUrl      String?
  quantity      Int
  rsStockNumber String?
  mpn           String?
  owner         Contact? @relation(fields: [ownerEmail], references: [email])
  ownerEmail    String?

  loans Loan[]
}

model Loan {
  id         String    @id @default(uuid(7))
  team       Team      @relation(fields: [teamId], references: [id])
  teamId     String
  item       Item      @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Int
  loanedAt   DateTime  @default(now())
  returnedAt DateTime?
}
